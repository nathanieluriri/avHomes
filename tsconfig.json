{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"],
      "@avhomes/contracts": ["./packages/contracts/src/index.ts"],
      "@avhomes/core": ["./packages/core/src/index.ts"],
      "@avhomes/db": ["./packages/db/src/index.ts"],
      "@avhomes/identity": ["./packages/identity/src/index.ts"],
      "@avhomes/listings": ["./packages/listings/src/index.ts"],
      "@avhomes/content": ["./packages/content/src/index.ts"],
      "@avhomes/media": ["./packages/media/src/index.ts"],
      "@avhomes/enquiries": ["./packages/enquiries/src/index.ts"],
      "@avhomes/settings": ["./packages/settings/src/index.ts"],
      "@avhomes/feedback": ["./packages/feedback/src/index.ts"],
      "@avhomes/analytics": ["./packages/analytics/src/index.ts"],
      "@avhomes/audience": ["./packages/audience/src/index.ts"],
      "@avhomes/audit": ["./packages/audit/src/index.ts"],
      "@avhomes/api": ["./packages/api/src/index.ts"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.mts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules", ".next", ".open-next"]
}
