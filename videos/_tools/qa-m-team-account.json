  {
    "name": "m-listings-focus-from-home",
    "path": "/m",
    "viewport": "phone",
    "steps": [
      {
        "wait": 1200
      },
      {
        "click": "a[href='/m/listings?focus=demo_kuje-garden-estate']",
        "wait": 1600,
        "shot": "ringing",
        "waitFor": "::-p-text(Homes to share)"
      },
      {
        "wait": 2600,
        "shot": "settled"
      },
      {
        "eval": "(() => { const a = [...document.querySelectorAll('article')]; const i = a.findIndex((n) => n.querySelector('h3').textContent === 'Kuje Garden Estate'); const r = a[i].getBoundingClientRect(); return { index: i, top: Math.round(r.top), bottom: Math.round(r.bottom), url: location.pathname + location.search }; })()"
      }
    ]
  },
  {
    "name": "m-listings-focus-rent",
    "path": "/m/listings?focus=demo_banana-island-penthouse-let",
    "viewport": "phone",
    "steps": [
      {
        "wait": 400,
        "shot": "landed"
      },
      {
        "eval": "(() => { const tab = document.querySelector('[role=tab][aria-selected=true]').textContent; const a = [...document.querySelectorAll('article')]; const n = a.find((x) => x.querySelector('h3').textContent === 'Banana Island Penthouse'); const r = n && n.getBoundingClientRect(); return { tab, found: Boolean(n), top: r && Math.round(r.top) }; })()"
      }
    ]
  },
